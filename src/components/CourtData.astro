---
import { Image } from 'astro:assets';
import calendarShot from '../assets/screenshots/calendar.png';

const points = [
  {
    n: '01',
    title: 'Official court records, connected',
    body: 'Case data pulled directly from court sources via CNR — no manual re-entry.',
  },
  {
    n: '02',
    title: 'Cause lists matched automatically',
    body: 'Daily cause lists auto-matched to your active matters.',
  },
  {
    n: '03',
    title: 'Every hearing, one calendar',
    body: 'Hearings, deadlines, and cause lists — one calendar.',
  },
];
---

<section id="court-data" class="bg-bg py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal max-w-2xl">
      <h2 class="text-3xl font-semibold text-ink sm:text-4xl">Court updates, matched automatically.</h2>
      <p class="mt-4 text-lg text-ink-muted">No more switching between court portals and spreadsheets.</p>
    </div>

    <div class="mt-16 grid gap-8 sm:grid-cols-3">
      {
        points.map((p) => (
          <div class="reveal border-t-2 border-brand pt-5">
            <span class="type-mono text-sm font-semibold text-brand-strong">{p.n}</span>
            <h3 class="font-display mt-3 text-xl font-semibold text-ink">{p.title}</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-muted">{p.body}</p>
          </div>
        ))
      }
    </div>

    <div class="reveal group mt-16 overflow-hidden rounded-card border border-border bg-surface p-2 shadow-pop transition-all duration-300 hover:-translate-y-1 hover:shadow-xl sm:p-3">
      <Image
        src={calendarShot}
        alt="NyayOps calendar showing hearings, deadlines, and payments across the month, with today's schedule alongside"
        class="rounded-[8px] transition-transform duration-300 group-hover:scale-[1.015]"
        widths={[640, 1000, 1600]}
        sizes="(min-width: 1152px) 1152px, 92vw"
      />
    </div>
  </div>
</section>
