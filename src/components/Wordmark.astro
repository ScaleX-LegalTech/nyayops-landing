---
import { Image } from 'astro:assets';
import logoIcon from '../assets/brand/logo-icon.png';

interface Props {
  size?: 'sm' | 'lg';
  /** Footer sits on the white surface, not the navy shell — Wordmark's default
   * shell-ink/accent pairing is contrast-verified for navy only (see DESIGN.md);
   * on white it renders near-invisible. Use onLight there. */
  onLight?: boolean;
}
const { size = 'sm', onLight = false } = Astro.props;
const badge = size === 'lg' ? 'size-11' : 'size-9';
const icon = size === 'lg' ? 'size-7' : 'size-6';
const text = size === 'lg' ? 'text-2xl' : 'text-xl';
---

<a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="NyayOps home">
  <span class:list={['grid shrink-0 place-items-center rounded-control bg-accent/15', badge]}>
    <Image src={logoIcon} alt="" class:list={['object-contain', icon]} widths={[28, 56]} sizes="28px" />
  </span>
  <span class:list={['font-display font-semibold', text, onLight ? 'text-ink' : 'text-shell-ink']}>
    Nyay<span class:list={[onLight ? 'text-brand' : 'text-accent']}>Ops</span>
  </span>
</a>
