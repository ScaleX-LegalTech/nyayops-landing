---
const points = [
  {
    title: 'Confidential matters stay confidential',
    body: 'Only the people responsible for a matter can view its information and documents.',
    icon: 'M12 2l7 3v6c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V5l7-3z',
  },
  {
    title: 'Access that matches responsibility',
    body: 'Partners, associates, reviewers, and administrators each have the right level of access.',
    icon: 'M12 2a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM4 21c0-4.4 3.6-8 8-8s8 3.6 8 8',
  },
  {
    title: 'AI follows your firm’s rules',
    body: 'Ask NyayOps assists your team while respecting approvals and established workflows.',
    icon: 'M9.5 3a3 3 0 0 0-3 3v.2A2.5 2.5 0 0 0 5 8.5v1a2.5 2.5 0 0 0-1 2v1a2.5 2.5 0 0 0 1 2v1A2.5 2.5 0 0 0 6.5 18v.2a3 3 0 0 0 3 2.8M14.5 3a3 3 0 0 1 3 3v.2A2.5 2.5 0 0 1 19 8.5v1a2.5 2.5 0 0 1 1 2v1a2.5 2.5 0 0 1-1 2v1a2.5 2.5 0 0 1-1.5 2.3v.2a3 3 0 0 1-3 2.8M9.5 3a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3',
  },
  {
    title: 'Every action leaves a record',
    body: 'A complete audit history provides transparency across every matter and decision.',
    icon: 'M9 12h6M9 16h6M9 8h6M5 4h14v16H5z',
  },
];
---

<section id="security" class="bg-surface-muted py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal max-w-2xl">
      <h2 class="text-3xl font-semibold text-ink sm:text-4xl">Security built around how legal teams work.</h2>
      <p class="mt-4 text-lg text-ink-muted">
        Protect client information, control access, and keep every action accountable — without adding complexity.
      </p>
    </div>

    <div class="mt-16 grid gap-5 sm:grid-cols-2">
      {
        points.map((p) => (
          <div class="reveal rounded-card bg-bg p-6 shadow-pop">
            <span class="grid size-9 place-items-center rounded-full bg-brand text-white">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                <path d={p.icon} />
              </svg>
            </span>
            <h3 class="mt-5 font-display text-xl font-semibold text-ink sm:text-2xl">{p.title}</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-muted">{p.body}</p>
          </div>
        ))
      }
    </div>

    <p class="reveal mt-10 border-t border-border pt-6 text-sm text-ink-muted">
      All of it lands in an audit trail that's only ever appended to — never edited, never deleted.
    </p>
  </div>
</section>
