---
const appUrl = 'https://workspace.nyayops.in';
---

<section class="bg-shell py-20 sm:py-28">
  <div class="reveal mx-auto max-w-3xl px-6 text-center">
    <h2 class="text-3xl font-semibold text-shell-ink sm:text-4xl">
      Bring your casework onto the ledger.
    </h2>
    <p class="mt-4 text-lg text-shell-ink-muted">
      One workspace for intake, review, documents, and the record of who did what.
    </p>
    <div class="mt-8">
      <a
        href={appUrl}
        class="inline-block rounded-full bg-brand px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-brand-strong"
      >
        Get started
      </a>
    </div>
  </div>
</section>
