---
import { Image } from 'astro:assets';
import casesShot from '../assets/screenshots/cases.png';

const appUrl = 'https://workspace.nyayops.in';

// Rising particles — real circular elements (not a composited gradient, which
// rasterizes into a soft/jagged blob at 1-3px sizes instead of a clean dot).
// Fixed configs generated once (deterministic SSR), not Math.random() at
// runtime. Spawn low (near/below the screenshot frame) and drift upward,
// matching the reference: dots emerge from the lower half, not scattered
// evenly behind the headline.
const PARTICLES = [
  { left: '48.3%', bottom: '42.1%', size: 2.4, duration: 15.3, delay: 16.3, peak: 0.52 },
  { left: '81.4%', bottom: '9.8%', size: 4.0, duration: 22.5, delay: 18.8, peak: 0.69 },
  { left: '59.1%', bottom: '7.4%', size: 3.5, duration: 16.8, delay: 1.6, peak: 0.81 },
  { left: '48.9%', bottom: '4.1%', size: 4.5, duration: 19.9, delay: 3.8, peak: 0.68 },
  { left: '61.4%', bottom: '2.7%', size: 2.5, duration: 15.5, delay: 9.2, peak: 0.40 },
  { left: '40.2%', bottom: '35.3%', size: 3.9, duration: 15.3, delay: 15.4, peak: 0.85 },
  { left: '43.8%', bottom: '37.1%', size: 4.3, duration: 16.5, delay: 9.1, peak: 0.42 },
  { left: '89.1%', bottom: '-8.3%', size: 2.5, duration: 16.0, delay: 7.2, peak: 0.78 },
  { left: '33.3%', bottom: '-7.3%', size: 4.4, duration: 16.1, delay: 5.8, peak: 0.53 },
  { left: '23.3%', bottom: '10.5%', size: 3.2, duration: 25.2, delay: 4.9, peak: 0.57 },
  { left: '89.9%', bottom: '13.7%', size: 4.9, duration: 22.7, delay: 11.5, peak: 0.49 },
  { left: '60.5%', bottom: '51.1%', size: 4.6, duration: 14.6, delay: 15.5, peak: 0.37 },
  { left: '11.7%', bottom: '39.1%', size: 3.6, duration: 21.5, delay: 15.7, peak: 0.45 },
  { left: '23.7%', bottom: '14.3%', size: 2.2, duration: 18.2, delay: 11.6, peak: 0.73 },
];
---

<section
  data-hero
  class="relative overflow-hidden"
  style="background: linear-gradient(180deg, oklch(0.279 0.05 264 / 1) 0%, var(--color-shell) 45%, oklch(0.13 0.03 265 / 1) 100%);"
>
  <!-- Ledger dot-grid texture — stationary, matches the same dotted pattern used
       on the app's own AuthLayout navy panel. -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.07]"
    style="background-image: radial-gradient(currentColor 1px, transparent 1px); background-size: 22px 22px; color: var(--color-shell-ink);"
    aria-hidden="true"
  >
  </div>

  <!-- Rising particles — real circular elements, spawn low near the
       screenshot frame and drift upward on a long loop, fading in then out.
       Frozen (shown at rest, mid-opacity, no motion) under
       prefers-reduced-motion. -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    {
      PARTICLES.map((p) => (
        <span
          class="particle absolute rounded-full bg-shell-ink"
          style={`left: ${p.left}; bottom: ${p.bottom}; width: ${p.size}px; height: ${p.size}px; --peak: ${p.peak}; animation-duration: ${p.duration}s; animation-delay: -${p.delay}s;`}
        />
      ))
    }
  </div>

  <!-- Ambient glow — two radial-gradient washes drifting slowly behind the content.
       Interpolated `in oklch` and faded across the full radius (not a hard-stopped
       65%) so there's no visible ring boundary. This is the hero's whole
       decorative motion budget: everything else on the page is still. Frozen
       under prefers-reduced-motion, not just slowed. -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div
      class="glow-blob absolute -left-40 top-[-160px] h-[760px] w-[760px]"
      style="background: radial-gradient(in oklch, circle, var(--color-brand) 0%, transparent 100%); opacity: 0.22;"
    >
    </div>
    <div
      class="glow-blob-alt absolute -right-32 top-24 h-[680px] w-[680px]"
      style="background: radial-gradient(in oklch, circle, var(--color-accent) 0%, transparent 100%); opacity: 0.14;"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-4xl px-6 pb-14 pt-24 text-center sm:pb-16 sm:pt-36">
    <div class="reveal">
      <h1
        data-hero-title
        class="text-[clamp(2.25rem,9vw,3.25rem)] font-semibold leading-[1.18] text-shell-ink sm:text-[clamp(2.75rem,6vw+1rem,5rem)] sm:leading-[1.05]"
      >
        Your legal operations,<br />now conversational.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-shell-ink-muted sm:mt-6 sm:text-lg">
        NyayOps brings your legal operations together in one intelligent
        workspace — where teams can manage matters, coordinate people,
        automate workflows, and keep every operation moving through simple
        conversations.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3 sm:mt-8 sm:gap-4">
        <a
          href={`${appUrl}/register`}
          class="rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-strong"
        >
          Talk to NyayOps
        </a>
        <a
          href="#ai-assistant"
          class="rounded-full border border-shell-border px-6 py-3 text-sm font-semibold text-shell-ink transition-colors hover:bg-shell-soft"
        >
          See how it works
        </a>
      </div>

      <ul class="mt-9 flex flex-wrap items-center justify-center gap-2 sm:mt-10">
        <li class="rounded-full border border-shell-border px-3 py-1.5 text-xs font-medium text-shell-ink-muted">
          Matter-level visibility
        </li>
        <li class="rounded-full border border-shell-border px-3 py-1.5 text-xs font-medium text-shell-ink-muted">
          Intelligent workflows
        </li>
        <li class="rounded-full border border-shell-border px-3 py-1.5 text-xs font-medium text-shell-ink-muted">
          Every action traceable
        </li>
      </ul>
    </div>
  </div>

  <!-- Framed product screenshot — pointer-tilts toward the cursor (perspective +
       rotateX/rotateY, smoothed by a rAF lerp loop). Static by default: the tilt
       is a hover enhancement, never required to see the image. A soft gradient
       rim-light border (the p-px + gradient-bg wrapper) instead of a flat solid
       border, so the frame reads as a lit window rather than a pasted screenshot.
       Sized to ~68% of a typical 1440px viewport. -->
  <div class="reveal relative mx-auto max-w-6xl px-6 pb-20 sm:pb-28" style="perspective: 1800px;">
    <div
      data-tilt-card
      class="rounded-card p-px shadow-pop"
      style="transform-style: preserve-3d; background: linear-gradient(180deg, oklch(1 0 0 / 0.22), oklch(1 0 0 / 0.05) 45%, transparent 75%);"
    >
      <div class="overflow-hidden rounded-[11px] bg-shell-soft">
        <div class="aspect-[16/10] overflow-hidden">
          <Image
            src={casesShot}
            alt="NyayOps case list showing filed matters with status and priority badges, each identified by a CS-#### case number"
            class="h-full w-full object-cover object-top"
            widths={[720, 1080, 1440, 1600]}
            sizes="(min-width: 1152px) 1100px, 90vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes rise {
    0% { transform: translateY(0); opacity: 0; }
    12% { opacity: var(--peak); }
    80% { opacity: var(--peak); }
    100% { transform: translateY(-62vh); opacity: 0; }
  }
  .particle {
    opacity: 0;
    animation-name: rise;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .particle {
      animation: none;
      opacity: var(--peak);
    }
  }

  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(20px, -16px) scale(1.04); }
  }
  @keyframes drift-alt {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-18px, 18px) scale(1.03); }
  }
  .glow-blob {
    animation: drift 22s ease-in-out infinite;
  }
  .glow-blob-alt {
    animation: drift-alt 26s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .glow-blob,
    .glow-blob-alt {
      animation: none;
    }
  }

  /* All Hero decorative animation (28 particles + 2 glow blobs) runs on
     infinite CSS timelines that don't stop just because the section scrolls
     out of view — Chrome keeps compositing them regardless, and that ongoing
     work is enough concurrent animated-layer load to make paint fall behind
     during fast scroll on weaker GPUs (symptom: stale/torn tile content
     briefly visible lower on the page — content from two different scroll
     moments appearing blended). Pausing everything the instant Hero isn't
     intersecting the viewport (see the IntersectionObserver below) removes
     that cost entirely for the rest of the scroll. */
  [data-hero][data-in-view='false'] .particle,
  [data-hero][data-in-view='false'] .glow-blob,
  [data-hero][data-in-view='false'] .glow-blob-alt {
    animation-play-state: paused;
  }
</style>

<script>
  import { animate } from 'motion';

  const reduceMotionForTitle = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const heroTitle = document.querySelector<HTMLElement>('[data-hero-title]');
  if (heroTitle && !reduceMotionForTitle) {
    animate(
      heroTitle,
      { opacity: [0.3, 1], scale: [0.95, 1] },
      { duration: 0.5, easing: [0.22, 1, 0.36, 1] },
    );
  }

  const heroSection = document.querySelector<HTMLElement>('[data-hero]');
  if (heroSection && 'IntersectionObserver' in window) {
    heroSection.dataset.inView = 'true';
    const heroIo = new IntersectionObserver(
      ([entry]) => {
        heroSection.dataset.inView = entry.isIntersecting ? 'true' : 'false';
      },
      { threshold: 0 },
    );
    heroIo.observe(heroSection);
  }

  const card = document.querySelector<HTMLElement>('[data-tilt-card]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (card && !reduceMotion) {
    const maxTilt = 3;
    let targetRotX = 0; // rotateX, driven by vertical cursor offset
    let targetRotY = 0; // rotateY, driven by horizontal cursor offset
    let curRotX = 0;
    let curRotY = 0;
    let curScale = 1;
    let targetScale = 1;
    let raf: number | null = null;

    const tick = () => {
      curRotX += (targetRotX - curRotX) * 0.1;
      curRotY += (targetRotY - curRotY) * 0.1;
      curScale += (targetScale - curScale) * 0.1;
      card.style.transform = `rotateX(${curRotX.toFixed(3)}deg) rotateY(${curRotY.toFixed(3)}deg) scale3d(${curScale.toFixed(4)}, ${curScale.toFixed(4)}, 1)`;

      const settled =
        Math.abs(targetRotX - curRotX) < 0.01 &&
        Math.abs(targetRotY - curRotY) < 0.01 &&
        Math.abs(targetScale - curScale) < 0.001;

      if (settled) {
        raf = null;
        card.style.willChange = 'auto'; // only promote a GPU layer while actually animating
      } else {
        raf = requestAnimationFrame(tick);
      }
    };

    const ensureLoop = () => {
      card.style.willChange = 'transform';
      if (raf === null) raf = requestAnimationFrame(tick);
    };

    card.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      targetRotX = -y * maxTilt;
      targetRotY = x * maxTilt;
      targetScale = 1.012;
      ensureLoop();
    });

    card.addEventListener('mouseleave', () => {
      targetRotX = 0;
      targetRotY = 0;
      targetScale = 1;
      ensureLoop();
    });
  }
</script>
