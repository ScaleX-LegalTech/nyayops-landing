---
import Wordmark from './Wordmark.astro';
const appUrl = 'https://workspace.nyayops.in';
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface py-12">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <Wordmark onLight />
      <p class="mt-3 max-w-xs text-sm text-ink-muted">
        Legal-operations casework, run like a ledger.
      </p>
    </div>

    <nav class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-muted">
      <a href="#product" class="hover:text-ink">Product</a>
      <a href="#how-it-works" class="hover:text-ink">How it works</a>
      <a href="#security" class="hover:text-ink">Security</a>
      <a href={`${appUrl}/login`} class="hover:text-ink">Sign in</a>
    </nav>
  </div>

  <div class="mx-auto mt-10 max-w-6xl border-t border-border px-6 pt-6 text-xs text-ink-muted">
    &copy; {year} NyayOps. All rights reserved.
  </div>
</footer>
