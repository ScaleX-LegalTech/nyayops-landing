---
const points = [
  {
    n: '01',
    title: 'Understands your legal operations',
    body: 'Answers come from matters, workflows, court updates, documents, and billing — not generic AI knowledge.',
  },
  {
    n: '02',
    title: 'Drafts, doesn’t decide',
    body: 'It puts assignments, bills, and notices in front of your team — nothing goes live untouched.',
  },
  {
    n: '03',
    title: 'Plays by your firm’s rules, not its own',
    body: 'Nothing gets applied without sign-off.',
  },
];
---

<section id="ai-assistant" class="bg-surface py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal max-w-2xl">
      <h2 class="text-3xl font-semibold text-ink sm:text-4xl">Ask NyayOps, governed like every other team member.</h2>
      <p class="mt-4 text-lg text-ink-muted">
        A conversational AI assistant that understands your matters, workflows, and permissions — available through chat or voice, with the same controls as everyone else.
      </p>
    </div>

    <div class="reveal mt-16 grid items-center gap-6 lg:grid-cols-[1.05fr_auto_0.85fr_auto_1fr] lg:gap-4">
      <!-- BEFORE — fragmented, effortful: loose stagger of separately-bordered
           question chips, each nudged off-axis so the column reads as scattered
           work rather than one coherent block. -->
      <div>
        <p class="type-mono text-xs uppercase tracking-wide text-ink-muted">Before</p>
        <p class="mt-2 font-display text-lg font-semibold leading-snug text-ink">
          It took multiple questions to understand one case
        </p>
        <p class="mt-1.5 text-xs text-ink-muted">Hours lost, spread across three separate people.</p>
        <ul class="mt-5 space-y-2">
          {
            [
              { q: '“Who’s the client POC?”', r: '-rotate-1' },
              { q: '“What’s the court status?”', r: 'rotate-1' },
              { q: '“Were the documents uploaded?”', r: '-rotate-1' },
              { q: '“Are the legal fees paid?”', r: 'rotate-1' },
            ].map((item) => (
              <li class={`w-fit max-w-[15rem] rounded-control border border-dashed border-border bg-bg px-3 py-2 text-sm text-ink-muted ${item.r}`}>
                {item.q}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex items-center justify-center py-1 text-accent-strong lg:py-0" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-6 rotate-90 lg:rotate-0">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </div>

      <!-- ASK NYAYOPS — deliberately just the one query. No answer text here;
           a thinking indicator implies the work is happening, not being shown. -->
      <div class="text-center lg:text-left">
        <p class="type-mono text-xs uppercase tracking-wide text-brand-strong">Ask NyayOps<br class="lg:hidden" /> Conversational AI</p>
        <p class="mt-4 font-display text-xl font-medium italic leading-snug text-ink">
          “Give me the complete update on this case.”
        </p>
        <div class="mt-4 inline-flex items-center gap-1.5 text-ink-muted" aria-hidden="true">
          <span class="thinking-dot size-1.5 rounded-full bg-current" />
          <span class="thinking-dot size-1.5 rounded-full bg-current" />
          <span class="thinking-dot size-1.5 rounded-full bg-current" />
        </div>
      </div>

      <div class="flex items-center justify-center py-1 text-accent-strong lg:py-0" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-6 rotate-90 lg:rotate-0">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </div>

      <!-- RESULT — the one column that gets full card treatment: solid,
           elevated, confident. Everything else in the row is intentionally
           lighter so this is where the eye lands. -->
      <div class="rounded-card border border-brand bg-bg p-6 shadow-pop">
        <p class="type-mono text-xs uppercase tracking-wide text-ink-muted">After</p>
        <p class="mt-2 font-display text-lg font-semibold text-ink">Complete answer in seconds</p>
        <p class="mt-1.5 text-xs text-ink-muted">One question, answered in full.</p>
        <ul class="mt-5 space-y-2.5 text-sm text-ink">
          <li class="flex items-center gap-2"><span class="text-accent-strong">✓</span> Client POC confirmed</li>
          <li class="flex items-center gap-2"><span class="text-accent-strong">✓</span> Files accounted for</li>
          <li class="flex items-center gap-2"><span class="text-accent-strong">✓</span> Court status updated</li>
          <li class="flex items-center gap-2"><span class="text-accent-strong">✓</span> Fees status clear</li>
        </ul>
      </div>
    </div>

    <div class="reveal mt-16 grid overflow-hidden rounded-card border border-border sm:grid-cols-3 sm:divide-x sm:divide-border">
      {
        points.map((p, i) => (
          <div class={`border-t border-border p-6 first:border-t-0 sm:border-t-0 ${i === 2 ? 'bg-brand/[0.06]' : ''}`}>
            <span class="type-mono text-xs font-semibold text-brand-strong">{p.n}</span>
            <h3 class="font-display mt-3 text-lg font-semibold text-ink">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">{p.body}</p>
          </div>
        ))
      }
    </div>

    <p class="reveal mt-10 border-t border-border pt-6 text-sm text-ink-muted">
      Chat or voice — the fastest way to manage legal operations.
    </p>
  </div>
</section>

<style>
  @keyframes thinking-bounce {
    0%, 80%, 100% { opacity: 0.25; transform: translateY(0); }
    40% { opacity: 1; transform: translateY(-2px); }
  }
  .thinking-dot {
    animation: thinking-bounce 1.2s ease-in-out infinite;
  }
  .thinking-dot:nth-child(2) { animation-delay: 0.15s; }
  .thinking-dot:nth-child(3) { animation-delay: 0.3s; }
  @media (prefers-reduced-motion: reduce) {
    .thinking-dot { animation: none; opacity: 0.6; }
  }
</style>
